import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

NPZ_PATH = "/content/drive/MyDrive/anature_revised/multiyear_catboost_npz_with_metadata_fast_WITH_SWVL1_WIND10M_STL1/ALLCITIES_train_xy_MULTIYEAR_2013_2025_fine0.005_S1_maxCM3000_TOP100_WITH_ROWCOL_LOCALFAST_WITH_SWVL1_WIND10M_STL1.npz"

data = np.load(NPZ_PATH, allow_pickle=True)

X = data["X"]
y = data["y"]
channels = data["channels"].astype(object).tolist()

print("NPZ keys:", data.files)
print("样本数:", X.shape)
print("特征数:", len(channels))
print("channels:", channels)

# =========================
# 1. Find EVI column
# =========================
evi_idx = None
for i, ch in enumerate(channels):
    if "EVI" in str(ch).upper():
        evi_idx = i
        break

if evi_idx is None:
    raise ValueError("No EVI column found in channels.")

print("EVI column:", channels[evi_idx])

# =========================
# 2. Get city metadata
# =========================
if "sample_city_id" not in data.files:
    raise ValueError("NPZ does not contain sample_city_id.")

sample_city_id = data["sample_city_id"]

if "sample_city_name" in data.files:
    sample_city_name = data["sample_city_name"].astype(str)
else:
    sample_city_name = sample_city_id.astype(str)

# =========================
# 3. Build sample-level dataframe
# =========================
df = pd.DataFrame({
    "city_id": sample_city_id,
    "city": sample_city_name,
    "EVI": X[:, evi_idx]
})

df = df[np.isfinite(df["EVI"])].copy()

# Optional: keep physically plausible EVI range
df = df[(df["EVI"] >= 0) & (df["EVI"] <= 1)].copy()

# =========================
# 4. City-level EVI statistics
# =========================
EVI_THR = 0.4

city_stats = (
    df.groupby(["city_id", "city"], as_index=False)
      .agg(
          mean_EVI=("EVI", "mean"),
          prop_EVI_ge04=("EVI", lambda x: np.mean(x >= EVI_THR)),
          std_EVI=("EVI", "std"),
          n_samples=("EVI", "size")
      )
)

print("\n城市数量:", len(city_stats))
print(city_stats.head())

n_city = len(city_stats)
n_high = np.sum(city_stats["mean_EVI"] >= EVI_THR)

print("\n===== GLOBAL SUMMARY =====")
print(f"城市总数: {n_city}")
print(f"mean_EVI >= {EVI_THR}: {n_high} ({n_high / n_city * 100:.2f}%)")

print("\nCity mean EVI summary:")
print(city_stats["mean_EVI"].describe())

print("\nProportion EVI >= 0.4 summary:")
print(city_stats["prop_EVI_ge04"].describe())

# =========================
# 5. Plot Fig. 3-style panels
# =========================
plt.figure(figsize=(14, 4))

plt.subplot(1, 3, 1)
plt.hist(
    city_stats["mean_EVI"],
    bins=np.linspace(0, 1, 21),
    edgecolor="black",
    alpha=0.7
)
plt.axvline(EVI_THR, color="red", linestyle="--")
plt.xlabel("City-level mean EVI")
plt.ylabel("Number of cities")
plt.title("Distribution of City Mean EVI")

plt.subplot(1, 3, 2)
plt.hist(
    city_stats["prop_EVI_ge04"],
    bins=np.linspace(0, 1, 21),
    edgecolor="black",
    alpha=0.7
)
plt.xlabel("Proportion of EVI >= 0.4")
plt.ylabel("Number of cities")
plt.title("High-Greenness Area Fraction")

plt.subplot(1, 3, 3)
plt.scatter(
    city_stats["mean_EVI"],
    city_stats["prop_EVI_ge04"],
    alpha=0.7
)
plt.axvline(EVI_THR, color="red", linestyle="--")
plt.axhline(0.4, color="orange", linestyle="--")
plt.xlabel("City Mean EVI")
plt.ylabel("Proportion EVI >= 0.4")
plt.title("Greenness Level vs High-Green Fraction")

plt.tight_layout()
plt.show()
