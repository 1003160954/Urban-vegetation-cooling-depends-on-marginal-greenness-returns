def gen_one_ts_for_clim(clim, rng):
    X_ts = np.zeros((T, len(channels)), dtype=np.float32)

    for j, ch in enumerate(channels):
        if (clim in lib) and (ch in lib[clim]):
            mu = lib[clim][ch]["mu"]
            sg = lib[clim][ch]["sigma"]
            plo = lib[clim][ch]["plo"]
            phi = lib[clim][ch]["phi"]

            mult = NOISE_MULT.get(ch, DEFAULT_NOISE_MULT)
            sigma0 = float(np.nanmedian(sg)) * NOISE_SCALE * float(mult)

            x = mu + ar1_noise(T, sigma=sigma0, rho=AR1_RHO, rng=rng)

            if CLIP_TO_P_BOUNDS:
                x = np.minimum(np.maximum(x, plo), phi)

            X_ts[:, j] = x.astype(np.float32)

        else:
            raise RuntimeError(f"Missing model channel {ch} for climate group {clim}.")

    return X_ts


