def norm_city(x):
    if pd.isna(x):
        return None
    return re.sub(r"[^a-z0-9]", "", str(x).lower())


def find_col(df, candidates, contains=None):
    contains = contains or []
    low = {c: str(c).strip().lower() for c in df.columns}

    for cand in candidates:
        cand = cand.lower()
        for c, lc in low.items():
            if lc == cand:
                return c

    for c, lc in low.items():
        if any(k.lower() in lc for k in contains):
            return c

    return None


def month_to_doy(month):
    # approximate month centers in non-leap year
    month_center = {
        1: 15, 2: 45, 3: 74, 4: 105, 5: 135, 6: 166,
        7: 196, 8: 227, 9: 258, 10: 288, 11: 319, 12: 349
    }
    return month_center[int(month)]


def steps_to_doy(T=46, dt=8.0):
    return np.arange(T) * dt + dt / 2.0


def interp_monthly_to_46(months, vals, T=46):
    """
    Interpolate monthly climatology to 46 8-day steps.
    Uses cyclic extension so Jan/Dec boundary is smooth.
    """
    months = np.asarray(months, dtype=int)
    vals = np.asarray(vals, dtype=float)

    m = np.isfinite(vals)
    months = months[m]
    vals = vals[m]

    if len(vals) == 0:
        return np.full(T, np.nan, dtype=float)

    if len(vals) == 1:
        return np.full(T, float(vals[0]), dtype=float)

    doys = np.array([month_to_doy(mo) for mo in months], dtype=float)

    order = np.argsort(doys)
    doys = doys[order]
    vals = vals[order]

    # cyclic extension
    doys_ext = np.concatenate([doys - 365.0, doys, doys + 365.0])
    vals_ext = np.concatenate([vals, vals, vals])

    target_doy = steps_to_doy(T)
    out = np.interp(target_doy, doys_ext, vals_ext)

    return out


