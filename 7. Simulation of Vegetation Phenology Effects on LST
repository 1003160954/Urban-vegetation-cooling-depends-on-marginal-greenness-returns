    "ERA5_VPD": "ERA5LMAIN.VPD",
    "ERA5_WIND10M": "ERA5LMAIN.WIND10M",
}

def doys(n=T):
    return np.arange(n) * DT + DT / 2

def stable_seed(key, mc):
    h = 2166136261
    for c in str(key):
        h ^= ord(c)
        h = (h * 16777619) & 0xffffffff
    return (SEED + (h % 100000) * 1000 + mc) % (2**32 - 1)

def ar1(n, sigma, rho=0.9, rng=None):
    if not np.isfinite(sigma) or sigma <= 0:
        return np.zeros(n)
    rng = np.random.default_rng() if rng is None else rng
    e = rng.normal(size=n)
    x = np.zeros(n)
    x[0] = rng.normal(0, sigma)
    inn = sigma * np.sqrt(max(1e-8, 1-rho**2))
    for i in range(1, n):
        x[i] = rho * x[i-1] + inn * e[i]
    return x

def resamp(x):
    x = np.asarray(x, float)
    if len(x) == T:
        return x
    return np.interp(np.linspace(0, 1, T), np.linspace(0, 1, len(x)), x)

def shift_window(x, days, win):
    x = np.asarray(x, float)
    if days == 0:
        return x.copy()
    d = doys(len(x))
    idx = np.where((d >= win[0]) & (d <= win[1]))[0]
    if len(idx) < 3:
        return x.copy()
    i0, i1 = idx[0], idx[-1]
    seg = x[i0:i1+1]
    s = days / DT
    k = np.arange(len(seg))
    src = np.clip(k + s, 0, len(seg)-1)
    a = np.floor(src).astype(int)
    b = np.clip(a + 1, 0, len(seg)-1)
    w = src - a
    y = x.copy()
    y[i0:i1+1] = (1-w) * seg[a] + w * seg[b]
    return y

def apply_shift(X, d, cols, vars_, win, direction=1):
    X1 = X.copy()
    for ch in vars_:
        if ch in cols:
            X1[:, cols[ch]] = shift_window(X1[:, cols[ch]], direction*d, win)
    return X1.astype(np.float32)

def calc_metrics(y):
    y = np.asarray(y, float)
    d = doys(len(y))
    warm = (d >= WARM[0]) & (d <= WARM[1])
    yw = y[warm]
    top_idx = np.argsort(y)[-3:]
    peak_time = float(np.mean(d[top_idx]))
    peak_lst = float(np.mean(y[top_idx]))
    thr = np.nanmedian(yw)
    return {
        "peak_time": peak_time,
        "peak_lst": peak_lst,
        "warm_p95": float(np.nanpercentile(yw, 95)),
        "heat_expo": float(np.nansum(np.maximum(0, yw-thr)) * DT),
    }

def cdiff(a, b):
    z = (a - b) % 365
    return z - 365 if z > 182.5 else z

