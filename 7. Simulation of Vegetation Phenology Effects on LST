# ============================================================
# 2. Helper functions
# ============================================================

def norm_city(x):
    return re.sub(r"[^a-z0-9]", "", str(x).lower())

def extract_koppen_code(x):
    s = str(x).strip()
    m = re.search(
        r"\b(Af|Am|Aw|As|BWh|BWk|BSh|BSk|Csa|Csb|Csc|Cwa|Cwb|Cwc|Cfa|Cfb|Cfc|"
        r"Dsa|Dsb|Dsc|Dsd|Dwa|Dwb|Dwc|Dwd|Dfa|Dfb|Dfc|Dfd|ET|EF)\b", s
    )
    return m.group(1) if m else None

def find_best_city_col(meta, npz_city_names):
    keys_npz = set(norm_city(c) for c in npz_city_names)
    best_col, best_n = None, -1
    for c in meta.columns:
        keys = set(norm_city(v) for v in meta[c].dropna().astype(str).unique())
        n = len(keys_npz & keys)
        if n > best_n:
            best_col, best_n = c, n
    if best_n <= 0:
        raise RuntimeError("Cannot match city column.")
    return best_col

def find_best_koppen_col(meta):
    best_col, best_n = None, -1
    for c in meta.columns:
        vals = meta[c].dropna().astype(str).head(500)
        n = vals.apply(extract_koppen_code).notna().sum()
        if n > best_n:
            best_col, best_n = c, n
    if best_n <= 0:
        raise RuntimeError("Cannot find Köppen code column.")
    return best_col

def doys(n=T):
    return np.arange(n) * DT + DT / 2

def month_doy(m):
    return {1:15,2:45,3:74,4:105,5:135,6:166,7:196,8:227,9:258,10:288,11:319,12:349}[int(m)]

def interp_month_to_46(months, vals):
    months = np.asarray(months, int)
    vals = np.asarray(vals, float)
    ok = np.isfinite(vals)
    months, vals = months[ok], vals[ok]
    if len(vals) == 0:
        return np.full(T, np.nan)
    if len(vals) == 1:
        return np.full(T, vals[0])
    x = np.array([month_doy(m) for m in months], float)
    order = np.argsort(x)
    x, vals = x[order], vals[order]
    xx = np.r_[x - 365, x, x + 365]
    yy = np.r_[vals, vals, vals]
    return np.interp(doys(T), xx, yy)

def smooth_curve(y, window=7, poly=2):
    y = np.asarray(y, float)
    if np.isfinite(y).sum() < 3:
        return y
    s = pd.Series(y).interpolate(limit_direction="both").values
    if HAS_SCIPY and len(s) >= window:
        w = min(window, len(s))
        if w % 2 == 0:
            w -= 1
        if w >= 5:
            return savgol_filter(s, window_length=w, polyorder=min(poly, w-2), mode="interp")
    return pd.Series(s).rolling(window, center=True, min_periods=1).mean().values

def normalize01(y):
    y = np.asarray(y, float)
    return (y - np.nanmin(y)) / (np.nanmax(y) - np.nanmin(y) + 1e-9)

def ar1_noise(n, sigma, rho=0.9, rng=None):
    if not np.isfinite(sigma) or sigma <= 0:
        return np.zeros(n)
    rng = np.random.default_rng() if rng is None else rng
    e = rng.normal(size=n)
    x = np.zeros(n)
    x[0] = rng.normal(0, sigma)
    inn = sigma * np.sqrt(max(1e-8, 1 - rho**2))
    for i in range(1, n):
        x[i] = rho * x[i-1] + inn * e[i]
    return x

def shift_window_no_wrap(x, days, win):
    x = np.asarray(x, float)
    if days <= 0:
        return x.copy()
    d = doys(len(x))
    idx = np.where((d >= win[0]) & (d <= win[1]))[0]
    if len(idx) < 3:
        return x.copy()
    i0, i1 = idx[0], idx[-1]
    seg = x[i0:i1+1]
    s = days / DT
    k = np.arange(len(seg))
    src = np.clip(k + s, 0, len(seg)-1)
    a = np.floor(src).astype(int)
    b = np.clip(a + 1, 0, len(seg)-1)
    w = src - a
    y = x.copy()
    y[i0:i1+1] = (1-w) * seg[a] + w * seg[b]
    return y

def metrics(y):
    y = np.asarray(y, float)
    d = doys(len(y))
    wm = (d >= WARM_DOY[0]) & (d <= WARM_DOY[1])
    yw = y[wm]
    top_idx = np.argsort(y)[-3:]
    return {
        "warm_p95": float(np.nanpercentile(yw, 95)),
        "heat_load": float(np.nansum(np.maximum(0, yw - np.nanmedian(yw))) * DT),
        "peak_doy": float(np.mean(d[top_idx])),
    }


# ============================================================
# 3. Load final NPZ and build NH Köppen labels
