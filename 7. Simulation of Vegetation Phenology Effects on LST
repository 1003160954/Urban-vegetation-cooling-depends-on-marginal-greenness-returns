        row[key + "_lo"] = float(np.mean(v) - 1.96 * np.std(v) / np.sqrt(len(v)))
        row[key + "_hi"] = float(np.mean(v) + 1.96 * np.std(v) / np.sqrt(len(v)))
    summary_rows.append(row)

df_summary = pd.DataFrame(summary_rows)
