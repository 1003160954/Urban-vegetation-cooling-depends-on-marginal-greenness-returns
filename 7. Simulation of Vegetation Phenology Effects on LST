meta2["koppen_code"] = meta2["koppen_raw"].apply(extract_koppen_code)
meta2["clim_major"] = meta2["koppen_code"].astype(str).str[0].str.upper()
meta2.loc[~meta2["clim_major"].isin(CLIM_ORDER), "clim_major"] = "UNK"

city2clim = dict(zip(meta2["key"], meta2["clim_major"]))
sample_key = np.array([norm_city(c) for c in city_npz], object)
sample_clim = np.array([city2clim.get(k, "UNK") for k in sample_key], object)

mask_nh = (lat_npz > 0) & np.isin(sample_clim, CLIM_ORDER)

print("NH samples:", int(mask_nh.sum()), "/", len(mask_nh))
print(pd.Series(sample_clim[mask_nh]).value_counts())

if mask_nh.sum() == 0:
    raise RuntimeError("No NH samples.")


# ============================================================
# 4. Build typical seasonal library for A/B/C/D
# ============================================================

lib = {}

for clim in CLIM_ORDER:
    mask_clim = mask_nh & (sample_clim == clim)
    if mask_clim.sum() == 0:
        continue

    base = pd.DataFrame({
        "city": city_npz[mask_clim],
        "month": month_npz[mask_clim],
    })

    lib[clim] = {}

    for ch, var in NPZ_VAR_MAP.items():
        if ch not in channels_npz:
            continue

        vals = X_npz[mask_clim, channels_npz.index(ch)]

        tmp = base.copy()
        tmp["value"] = vals
        tmp = tmp[np.isfinite(tmp["value"])]

        cm = tmp.groupby(["city", "month"], as_index=False)["value"].mean()

        city_curves = []
        for _, g in cm.groupby("city"):
            curve = interp_month_to_46(g["month"].values, g["value"].values)
            if np.isfinite(curve).sum() > 0:
                city_curves.append(curve)

        if len(city_curves) == 0:
            continue

        arr = np.vstack(city_curves)

        lib[clim][var] = {
            "mean": np.nanmean(arr, axis=0),
            "p10": np.nanpercentile(arr, 10, axis=0),
            "p90": np.nanpercentile(arr, 90, axis=0),
            "mean_s": smooth_curve(np.nanmean(arr, axis=0)),
            "p10_s": smooth_curve(np.nanpercentile(arr, 10, axis=0)),
            "p90_s": smooth_curve(np.nanpercentile(arr, 90, axis=0)),
            "n_series": len(city_curves),
        }

print("Climate groups in lib:", sorted(lib.keys()))


# ============================================================
# 5. Load model
# ============================================================

model = CatBoostRegressor()
model.load_model(MODEL_PATH)

channels = np.load(CHANNELS_NPY, allow_pickle=True).tolist()
feat2idx = {c: i for i, c in enumerate(channels)}

print("Model channels:", channels)

for clim in lib:
    missing = []
    for ch in channels:
        var = None
        for k, v in MODEL_VAR_MAP.items():
            if v == ch:
                var = k
                break
        if var not in lib[clim]:
            missing.append(ch)
    if missing:
        raise RuntimeError(f"{clim} missing model predictors: {missing}")


# ============================================================
# 6. Monte Carlo simulation across A/B/C/D
# ============================================================

rng = np.random.default_rng(SEED)

rows = []
Y0_all = []
Y10_all = []
Y30_all = []
CLIM_ALL = []

X0_show = None
scenarios_show = None

for clim in sorted(lib.keys()):
    print("MC clim:", clim)

    for mc in range(N_MC_PER_CLIM):
        X0 = np.zeros((T, len(channels)), np.float32)

        for ch in channels:
            var = None
            for k, v in MODEL_VAR_MAP.items():
                if v == ch:
                    var = k
                    break

            obj = lib[clim][var]
            mean = obj["mean"]
            p10 = obj["p10"]
            p90 = obj["p90"]

            sig = (p90 - p10) / 2.563
            sigma0 = np.nanmedian(sig) * NOISE_SCALE * NOISE_MULT.get(ch, 0.08)

            x = mean + ar1_noise(T, sigma0, AR1_RHO, rng)
            x = np.clip(x, p10, p90)

            X0[:, feat2idx[ch]] = x.astype(np.float32)

        y0 = model.predict(X0).astype(np.float32)
        m0 = metrics(y0)

        scen = {"Baseline": {"X": X0.copy(), "y": y0, "metrics": m0}}

        for d in ADVANCE_LIST:
            X1 = X0.copy()

            for ch in VEG_CH:
                j = feat2idx[ch]
                X1[:, j] = shift_window_no_wrap(X1[:, j], d, GREENUP_DOY).astype(np.float32)

            y1 = model.predict(X1).astype(np.float32)
            m1 = metrics(y1)

            scen[f"Advance {d} d"] = {
                "X": X1,
                "y": y1,
                "metrics": m1,
                "delta_p95": m1["warm_p95"] - m0["warm_p95"],
                "delta_heat": m1["heat_load"] - m0["heat_load"],
                "delta_peak": m1["peak_doy"] - m0["peak_doy"],
            }

            rows.append({
                "clim": clim,
                "mc": mc,
                "delta_days": d,
                "d_warm_p95": m1["warm_p95"] - m0["warm_p95"],
                "d_heat_expo": m1["heat_load"] - m0["heat_load"],
                "d_peak_time": m1["peak_doy"] - m0["peak_doy"],
            })


        Y0_all.append(y0)
        Y10_all.append(scen["Advance 10 d"]["y"])
        Y30_all.append(scen["Advance 30 d"]["y"])
        CLIM_ALL.append(clim)
        if X0_show is None:
            X0_show = X0.copy()
            scenarios_show = scen

Y0_all = np.asarray(Y0_all)
Y10_all = np.asarray(Y10_all)
Y30_all = np.asarray(Y30_all)
CLIM_ALL = np.asarray(CLIM_ALL)

df_raw = pd.DataFrame(rows)
df_raw.to_csv(OUT_RAW, index=False)

summary_rows = []
for d in ADVANCE_LIST:
    sub = df_raw[df_raw["delta_days"] == d]
    row = {"delta_days": d, "n": len(sub)}
    for key in ["d_warm_p95", "d_heat_expo", "d_peak_time"]:
