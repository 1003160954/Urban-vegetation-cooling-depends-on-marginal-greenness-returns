def positive_deltas_by_1pct_steps(
    x_series,
    feat_name,
    hi=0.90,
    pct_step=0.02,
    max_points=80
):
    """
    Generate positive perturbation values.

    Preserved logic:
    - EVI uses a fixed perturbation extension to Δ = 0.6.
    - LAI uses a fixed perturbation extension to Δ = 2.5.
    - Other variables fall back to Q_hi - mean_pos.

    Important correction:
    The previous code computed max_inc but then used np.linspace(0, 1.2, ...),
    which ignored the intended perturbation range. Here it uses max_inc.
    """
    x = x_series.to_numpy()
    pos_mask = np.isfinite(x) & (x > 0)

    if pos_mask.sum() == 0:
        return np.array([0.0, 1e-3], dtype=np.float32)

    mean_pos = float(np.mean(x[pos_mask]))

    # Fixed Δ extension for target vegetation variables
    if feat_name == "EVI.EVI":
        max_inc = 0.60
    elif feat_name == "LAI.LAI":
        max_inc = 2.50
    else:
        q_hi = float(np.quantile(x[pos_mask], hi))
        max_inc = max(0.0, q_hi - mean_pos)

    max_inc = float(max_inc)

    if max_inc <= 1e-8:
        return np.array([0.0, 1e-4], dtype=np.float32)

    step = max(1e-6, pct_step * max(mean_pos, 1e-6))

    if max_inc < step:
        return np.array([0.0, max(1e-4, max_inc)], dtype=np.float32)

    n_steps = int(np.floor(max_inc / step)) + 1
    n_steps = min(n_steps, max_points)

    deltas = np.linspace(0.0, max_inc, n_steps, dtype=np.float32)
    return deltas


def clip_feature(name, arr):
    """
    Clip perturbed features to reasonable ranges.
    """
    if name == "EVI.EVI":
        return np.clip(arr, 0.0, 1.0)

    if name == "LAI.LAI":
        return np.clip(arr, 0.0, 8.0)

    return arr


def perturb_and_response_positive_fast(
    model,
    X_np,
    y_base,
    feat_idx,
    base_feat_vals,
    deltas,
    feature_name
):
    """
    Vectorised accelerated version.

    Inputs:
    - X_np: numpy array of subset, shape = [n, p]
    - y_base: observed baseline target, kept for compatibility with original design
    - feat_idx: index of vegetation feature
    - base_feat_vals: original feature values
    - deltas: perturbation array
    - feature_name: feature name for clipping

    Returns:
    - mean(pred_perturbed) - mean(pred_baseline) for each Δ

    Note:
    The baseline uses model prediction under original feature values.
    This is consistent with perturbation-response analysis.
    """
    if X_np.shape[0] == 0:
        return np.array([], dtype=np.float32)

    mask_pos = np.isfinite(base_feat_vals) & (base_feat_vals > 0)

    if not mask_pos.any():
        return np.array([], dtype=np.float32)

    X_pos = np.asarray(X_np[mask_pos], dtype=np.float32).copy()
    y_pos = y_base[mask_pos]  # kept for method compatibility; not used directly

    base_pred = model.predict(X_pos).astype(np.float32)
    base_mean = float(np.nanmean(base_pred))

    res = []
    orig_vals = X_pos[:, feat_idx].copy()

    for d in deltas:
        X_mod = X_pos.copy()
        new_vals = clip_feature(feature_name, orig_vals + d)
        X_mod[:, feat_idx] = new_vals.astype(np.float32)

        y_pred = model.predict(X_mod).astype(np.float32)
        res.append(float(np.nanmean(y_pred) - base_mean))

    return np.array(res, dtype=np.float32)


