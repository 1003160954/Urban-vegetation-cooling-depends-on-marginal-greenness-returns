def add_quantile_subsets(col_name, label):
    """
    Add high/low background subsets according to P80/P20 of selected variable.
    """
    if col_name is None:
        print(f"[Warning] Column {label} not found; skipping {label} background subset.")
        return

    v = Xv[col_name].to_numpy()

    valid = np.isfinite(v)

    if valid.sum() == 0:
        print(f"[Warning] Column {label} has no finite values; skipping.")
        return

    q20 = np.nanquantile(v, 0.20)
    q80_local = np.nanquantile(v, 0.80)

    subsets[f"High{label}(≥P80)"] = valid & (v >= q80_local)
    subsets[f"Low{label}(≤P20)"] = valid & (v <= q20)


