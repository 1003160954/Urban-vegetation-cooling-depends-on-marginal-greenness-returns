for i, row in plot_df.iterrows():
    y_i = list(plot_df.index).index(i)
    x_i = row["shap_mean_abs_mean"] + row["shap_mean_abs_ci95"]
    plt.text(x_i, y_i, f"  freq={row['topk_freq']:.2f}", va="center")

plt.xlabel("Mean |SHAP| across city-group folds")
plt.title(f"CV-SHAP stability, City-GroupKFold K={N_SPLITS}")
plt.tight_layout()

out_fig = os.path.join(run_dir, "cv_shap_top15_stability.png")
plt.savefig(out_fig, dpi=300, bbox_inches="tight")
plt.show()

print("Saved to:", run_dir)
print("Files:", sorted(os.listdir(run_dir))[:30])

