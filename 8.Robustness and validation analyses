def split_by_city(df, city_col=CITY_COL, test_frac=0.2, seed=42):
    rng = np.random.default_rng(seed)
    cities = np.array(sorted(df[city_col].unique()))
    n_test = max(1, int(round(test_frac * len(cities))))
    test_cities = set(rng.choice(cities, size=n_test, replace=False).tolist())
    tr = df[~df[city_col].isin(test_cities)].copy()
    te = df[df[city_col].isin(test_cities)].copy()
    return tr, te, sorted(list(test_cities))


def evaluate(pred, y_true):
    rmse = float(mean_squared_error(y_true, pred) ** 0.5)
    mae = float(mean_absolute_error(y_true, pred))
    r2 = float(r2_score(y_true, pred))
    return dict(rmse=rmse, mae=mae, r2=r2)


def build_Xy(df, drop_cols=(), y_col="__y__", city_col=CITY_COL):
    drop_cols = set(drop_cols) | set(DROP_MAIN)

    cols = [
        c for c in df.columns
        if c not in [y_col, city_col]
        and not c.upper().startswith("LST.")
        and "LST" not in c.upper()
        and c not in drop_cols
    ]

    X = df[cols].to_numpy(np.float32)
    y = df[y_col].to_numpy(np.float32)
    return X, y, cols


def fit_catboost(X_tr, y_tr, X_te, y_te, feature_names, params, try_gpu=True):
    train_pool = Pool(X_tr, y_tr, feature_names=feature_names)
    test_pool = Pool(X_te, y_te, feature_names=feature_names)

    if try_gpu:
        try:
            model = CatBoostRegressor(**params, task_type="GPU", devices="0")
            model.fit(train_pool, eval_set=test_pool, use_best_model=True)
            return model, True
        except Exception as e:
            print("[GPU fallback]", repr(e))

    model = CatBoostRegressor(**params)
    model.fit(train_pool, eval_set=test_pool, use_best_model=True)
    return model, False


