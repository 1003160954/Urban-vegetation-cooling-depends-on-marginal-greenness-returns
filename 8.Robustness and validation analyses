def naive_perm_delta_rmse(model, X_df, y, col, seed=42, n_repeats=5):
    if col not in X_df.columns:
        return None

    rng = np.random.default_rng(seed)
    deltas = []

    for _ in range(n_repeats):
        Xp = X_df.copy()
        Xp[col] = rng.permutation(Xp[col].values)
        pred = model.predict(Xp.to_numpy(np.float32))
        deltas.append(rmse(y, pred) - rmse0)

    return {
        "mean": float(np.mean(deltas)),
        "std": float(np.std(deltas)),
        "repeats": n_repeats,
    }


def conditional_residual_perm_delta_rmse(
    model, X_train_df, X_test_df, y_test, target_col,
    alpha=1.0, seed=42, n_repeats=5
):
    if target_col not in X_test_df.columns:
        return None

    other_cols = [c for c in X_train_df.columns if c != target_col]

    tr = X_train_df[[target_col] + other_cols].copy()
    te = X_test_df[[target_col] + other_cols].copy()

    mtr = np.isfinite(tr.to_numpy()).all(axis=1)
    mte = np.isfinite(te.to_numpy()).all(axis=1)

    tr = tr.loc[mtr]
    te = te.loc[mte]

    reg = Ridge(alpha=alpha)
    reg.fit(
        tr[other_cols].to_numpy(np.float32),
        tr[target_col].to_numpy(np.float32)
    )

    yhat_te = reg.predict(te[other_cols].to_numpy(np.float32))
    resid_te = te[target_col].to_numpy(np.float32) - yhat_te

    rng = np.random.default_rng(seed)
    deltas = []

    for _ in range(n_repeats):
        Xp = X_test_df.copy()
        resid_perm = rng.permutation(resid_te)
        Xp.loc[mte, target_col] = (yhat_te + resid_perm).astype(np.float32)

        pred = model.predict(Xp.to_numpy(np.float32))
        deltas.append(rmse(y_test, pred) - rmse0)

    return {
        "mean": float(np.mean(deltas)),
        "std": float(np.std(deltas)),
        "repeats": n_repeats,
        "alpha": float(alpha),
        "n_test_used": int(mte.sum()),
    }


step3 = {
    "baseline_rmse": rmse0,
    "naive": {},
    "conditional_residual": {},
}

