import os, json, math
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from itertools import combinations
from datetime import datetime
from catboost import CatBoostRegressor, Pool
from sklearn.model_selection import GroupKFold
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score


# --------------------------
# 0) CONFIG
# --------------------------
NPZ_PATH = "/content/drive/MyDrive/anature_revised/multiyear_catboost_npz_with_metadata_fast_WITH_SWVL1_WIND10M_STL1/ALLCITIES_train_xy_MULTIYEAR_2013_2025_fine0.005_S1_maxCM3000_TOP100_WITH_ROWCOL_LOCALFAST_WITH_SWVL1_WIND10M_STL1.npz"

OUT_DIR = "/content/cv_shap_results_final"
os.makedirs(OUT_DIR, exist_ok=True)

RANDOM_SEED = 42
N_SPLITS = 5

DROP_LIST = {
    "ERA5LMAIN.STL1",
    "ERA5LMAIN.T2M",
    "ERA5LMAIN.TD",
    "META.CITY_ID",
}

SHAP_MAX_SAMPLES_PER_FOLD = 120_000
SHAP_TOPK = 20

CB_PARAMS_GPU = dict(
    iterations=8000,
    depth=8,
    learning_rate=0.08,
    l2_leaf_reg=3.0,
    loss_function="RMSE",
    eval_metric="RMSE",
    random_seed=RANDOM_SEED,
    task_type="GPU",
    devices="0",
    od_type="Iter",
    od_wait=200,
    verbose=200,
)

CB_PARAMS_CPU = dict(
    iterations=3000,
    depth=8,
    learning_rate=0.05,
    l2_leaf_reg=3.0,
    loss_function="RMSE",
    eval_metric="RMSE",
    random_seed=RANDOM_SEED,
    od_type="Iter",
    od_wait=200,
    verbose=200,
)


# --------------------------
# 1) LOAD DATA
# --------------------------
npz = np.load(NPZ_PATH, allow_pickle=True)

X_raw = npz["X"].astype(np.float32)
y_raw = npz["y"].astype(np.float32)
channels_raw = npz["channels"].astype(object).tolist()

if "sample_city_id" not in npz.files:
    raise RuntimeError("NPZ missing sample_city_id. Cannot run City-GroupKFold.")

groups_raw = npz["sample_city_id"].astype(np.int32)

mask = np.isfinite(y_raw)
X_raw = X_raw[mask]
y = y_raw[mask]
groups_city = groups_raw[mask]

keep_idx = []
dropped = []

for i, ch in enumerate(channels_raw):
    ch_upper = str(ch).upper()

    if ch in DROP_LIST:
        dropped.append(ch)
    elif ch_upper.startswith("LST.") or "LST" in ch_upper:
        dropped.append(ch)
    else:
        keep_idx.append(i)

X = X_raw[:, keep_idx]
features = [channels_raw[i] for i in keep_idx]

print("Loaded:")
print("X:", X.shape)
print("y:", y.shape)
print("n cities:", len(np.unique(groups_city)))
print("features:", features)
print("dropped:", dropped)

assert "META.CITY_ID" not in features
assert "ERA5LMAIN.T2M" not in features
assert "ERA5LMAIN.TD" not in features
assert "ERA5LMAIN.STL1" not in features


# --------------------------
# 2) HELPERS
# --------------------------
def eval_metrics(y_true, y_pred):
    return {
        "rmse": float(mean_squared_error(y_true, y_pred) ** 0.5),
        "mae": float(mean_absolute_error(y_true, y_pred)),
        "r2": float(r2_score(y_true, y_pred)),
    }


def train_catboost(X_tr, y_tr, X_te, y_te, feature_names):
    train_pool = Pool(X_tr, y_tr, feature_names=feature_names)
    test_pool = Pool(X_te, y_te, feature_names=feature_names)

    try:
        model = CatBoostRegressor(**CB_PARAMS_GPU)
        model.fit(train_pool, eval_set=test_pool, use_best_model=True)
        return model, True

    except Exception as e:
        print("[GPU fallback]", repr(e))
        model = CatBoostRegressor(**CB_PARAMS_CPU)
        model.fit(train_pool, eval_set=test_pool, use_best_model=True)
        return model, False


def shap_mean_abs(model, X_te, feature_names, max_samples=120_000, seed=42):
    n = X_te.shape[0]
    rng = np.random.default_rng(seed)

    if n > max_samples:
        idx = rng.choice(n, size=max_samples, replace=False)
        Xs = X_te[idx]
    else:
        Xs = X_te

    pool = Pool(Xs, feature_names=feature_names)
    shap = model.get_feature_importance(pool, type="ShapValues")
    shap = np.asarray(shap)[:, :-1]

    return np.mean(np.abs(shap), axis=0), Xs.shape[0]


def rank_desc(v):
    order = np.argsort(-v)
    ranks = np.empty_like(order)
    ranks[order] = np.arange(1, len(v) + 1)
    return ranks


def spearman_from_values(a, b):
    ra = rank_desc(a).astype(float)
    rb = rank_desc(b).astype(float)

    ra -= ra.mean()
    rb -= rb.mean()

    den = np.sqrt(np.sum(ra ** 2) * np.sum(rb ** 2))
    return float(np.sum(ra * rb) / den) if den > 0 else np.nan


# --------------------------
# 3) CV LOOP
# --------------------------
gkf = GroupKFold(n_splits=N_SPLITS)

stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
run_dir = os.path.join(OUT_DIR, f"cv_shap_city_{stamp}")
os.makedirs(run_dir, exist_ok=True)

fold_metrics = []
fold_shap = []
fold_topk = []

print("Run dir:", run_dir)

for fold, (tr_idx, te_idx) in enumerate(gkf.split(X, y, groups=groups_city), start=1):
    X_tr, y_tr = X[tr_idx], y[tr_idx]
    X_te, y_te = X[te_idx], y[te_idx]

    train_groups = len(np.unique(groups_city[tr_idx]))
    test_groups = len(np.unique(groups_city[te_idx]))

    print(f"\n[Fold {fold}] train={X_tr.shape}, test={X_te.shape}, groups={train_groups}/{test_groups}")

    model, used_gpu = train_catboost(X_tr, y_tr, X_te, y_te, features)

    pred = model.predict(X_te)
    met = eval_metrics(y_te, pred)

    met.update({
        "fold": fold,
        "n_train": int(X_tr.shape[0]),
        "n_test": int(X_te.shape[0]),
        "train_groups": int(train_groups),
        "test_groups": int(test_groups),
        "used_gpu": bool(used_gpu),
    })

    fold_metrics.append(met)

    print(f"RMSE={met['rmse']:.3f}, MAE={met['mae']:.3f}, R2={met['r2']:.3f}, GPU={used_gpu}")

    mean_abs, n_used = shap_mean_abs(
        model,
        X_te,
        features,
        max_samples=SHAP_MAX_SAMPLES_PER_FOLD,
        seed=RANDOM_SEED + fold,
    )

    fold_shap.append(mean_abs)

    top_idx = np.argsort(-mean_abs)[:SHAP_TOPK]
    top_names = [features[i] for i in top_idx]
    fold_topk.append(top_names)

    print(f"SHAP n={n_used:,}, Top1={top_names[0]}")

    np.save(os.path.join(run_dir, f"fold{fold:02d}_shap_meanabs.npy"), mean_abs)

    with open(os.path.join(run_dir, f"fold{fold:02d}_top{SHAP_TOPK}.json"), "w") as f:
        json.dump({"fold": fold, "top_features": top_names}, f, indent=2)


# --------------------------
# 4) AGGREGATE
# --------------------------
metrics_df = pd.DataFrame(fold_metrics)
metrics_df.to_csv(os.path.join(run_dir, "cv_metrics.csv"), index=False)

S = np.vstack(fold_shap)
mean_imp = S.mean(axis=0)
std_imp = S.std(axis=0, ddof=1)
ci95 = 1.96 * std_imp / math.sqrt(N_SPLITS)

topk_freq = {f: 0 for f in features}
for top_list in fold_topk:
    for f in top_list:
        topk_freq[f] += 1

topk_freq = {k: v / N_SPLITS for k, v in topk_freq.items()}

pair_rhos = []
for i, j in combinations(range(N_SPLITS), 2):
    pair_rhos.append(spearman_from_values(S[i], S[j]))

summary_df = pd.DataFrame({
    "feature": features,
    "shap_mean_abs_mean": mean_imp,
    "shap_mean_abs_std": std_imp,
    "shap_mean_abs_ci95": ci95,
    "topk_freq": [topk_freq[f] for f in features],
}).sort_values("shap_mean_abs_mean", ascending=False)

summary_df.to_csv(os.path.join(run_dir, "cv_shap_summary.csv"), index=False)

summary = {
    "cv_type": "City-GroupKFold using sample_city_id metadata",
    "n_splits": N_SPLITS,
    "features": features,
    "dropped": dropped,
    "metrics_mean": {
        "rmse": float(metrics_df["rmse"].mean()),
        "mae": float(metrics_df["mae"].mean()),
        "r2": float(metrics_df["r2"].mean()),
    },
    "metrics_std": {
        "rmse": float(metrics_df["rmse"].std(ddof=1)),
        "mae": float(metrics_df["mae"].std(ddof=1)),
        "r2": float(metrics_df["r2"].std(ddof=1)),
    },
    "rank_stability_spearman": {
        "pairwise_rho_mean": float(np.nanmean(pair_rhos)),
        "pairwise_rho_std": float(np.nanstd(pair_rhos, ddof=1)),
        "pairwise_rhos": [float(x) for x in pair_rhos],
    },
}

with open(os.path.join(run_dir, "cv_shap_summary.json"), "w") as f:
    json.dump(summary, f, indent=2)

print("\nCV-SHAP finished.")
print("metrics mean:", summary["metrics_mean"])
print("rank stability:", summary["rank_stability_spearman"])


# --------------------------
# 5) PLOT
# --------------------------
TOPPLOT = min(15, len(features))
plot_df = summary_df.head(TOPPLOT).copy()

ypos = np.arange(plot_df.shape[0])

plt.figure(figsize=(9, 6))
plt.barh(ypos, plot_df["shap_mean_abs_mean"].values)
plt.errorbar(
    plot_df["shap_mean_abs_mean"].values,
    ypos,
    xerr=plot_df["shap_mean_abs_ci95"].values,
    fmt="none",
    color="black",
    linewidth=1,
