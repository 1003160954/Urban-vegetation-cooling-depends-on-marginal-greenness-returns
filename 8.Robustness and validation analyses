ALLOW_EXT = {".tif", ".tiff"}
DATE8  = re.compile(r"(?:^|_)(\d{8})(?:_|$)")
SUBVAR = re.compile(r"^[A-Za-z0-9]+")
NTL_KEYS = {"NTL","VIIRS","NIGHT","NIGHTLIGHT"}

def list_city_files(city):
    cdir = os.path.join(ROOT, city)
    files = [f for f in sorted(os.listdir(cdir))
             if os.path.isfile(os.path.join(cdir,f)) and os.path.splitext(f)[1].lower() in ALLOW_EXT]
    return cdir, files

def infer_var_from_filename(filename, city):
    base = re.sub(rf"^{re.escape(city)}_", "", filename, flags=re.IGNORECASE)
    return base.split("_")[0].upper()

def yyyymm_from_yyyymmdd(d8):
    return d8[:6] if (d8 and len(d8)==8) else None

def parse_band_desc(desc, major_var):
    subvar, mkey = None, "STATIC"
    if desc:
        m_date = DATE8.search(desc)
        if m_date:
            mm = yyyymm_from_yyyymmdd(m_date.group(1))
            mkey = mm if mm else "STATIC"
        m_sv = SUBVAR.search(desc)
        if m_sv:
            subvar = m_sv.group(0).upper()
    if subvar is None:
        subvar = major_var
    return f"{major_var}.{subvar}", mkey  # e.g., ERA5LMAIN.VPD, 201907/STATIC

def get_band_descs(ds):
    descs = list(ds.descriptions) if ds.descriptions and any(ds.descriptions) else [None]*ds.count
    if len(descs)!=ds.count:
        descs = (descs + [None]*ds.count)[:ds.count]
    return descs

def out_hw(h,w,s):
    return math.ceil(h/s), math.ceil(w/s)

def is_categorical_channel(chname: str) -> bool:
    up = chname.upper()
    return up.startswith("LC") or ".LC" in up or "MODIS.LC" in up

def read_downsample(ds, b, oh, ow, resampling):
    arr = ds.read(b, masked=True, out_shape=(oh,ow), resampling=resampling).astype(np.float32)
    if np.ma.isMaskedArray(arr):
        arr = arr.filled(np.nan)
    return arr

def choose_target_channel(channels):
    # try common names; adapt if your band naming differs
    prefs = ("LST.LSTD", "LST.LST_DAY", "LST_DAY")
    for pref in prefs:
        for ch in channels:
            if ch.upper().endswith(pref.upper()):
                return ch
    for ch in channels:
        if "LST" in ch.upper() and "LSTN" not in ch.upper():
            return ch
    for ch in channels:
        if "LST" in ch.upper():
            return ch
    return None

def find_ntl_channel(channels):
    for ch in channels:
        if any(k in ch.upper() for k in NTL_KEYS):
            return ch
    return None

def build_ntl_core_mask(ntl_img, pct_brightest=90, ntl_min_abs=0.0):
    m = np.isfinite(ntl_img)
    if not m.any():
        return np.ones_like(ntl_img, dtype=bool)
    vals = ntl_img[m]
    q = np.nanpercentile(vals, 100 - pct_brightest)  # keep top pct
    return m & (ntl_img >= max(q, ntl_min_abs))

def infer_water_mask_from_lc(channels, ch2i, slab0):
    lc_candidates = [c for c in channels if c.upper().startswith("LC") or "MODIS.LC" in c.upper()]
    if not lc_candidates:
        return None
    lc_ch  = lc_candidates[0]
    lc_idx = ch2i[lc_ch]
    lc_img = slab0[..., lc_idx]
    lc_round = np.rint(lc_img).astype(np.float32)
    water_mask = np.isfinite(lc_round) & (lc_round == float(WATER_CODE))
    return water_mask

def era5_block_size(fine_deg, era_deg, spatial_subsample):
    eff_deg = fine_deg * spatial_subsample
    blk = int(round(era_deg / eff_deg))
    return max(1, blk)

def era5_guided_one_pixel_per_block_waterdrop(valid_mask_2d, block, rng,
                                              water_mask_2d=None,
                                              water_frac_thr=0.7,
                                              require_land_pixel=True):
    H, W = valid_mask_2d.shape
    Hb = H // block
    Wb = W // block
    if Hb == 0 or Wb == 0:
        return np.array([], dtype=np.int64), {"blocks_total": 0, "blocks_used": 0, "blocks_drop_water": 0}

    Ht, Wt = Hb * block, Wb * block
    valid_trim = valid_mask_2d[:Ht, :Wt]
    valid_blk = valid_trim.reshape(Hb, block, Wb, block).transpose(0,2,1,3)
    valid_count = valid_blk.sum(axis=(2,3)).astype(np.int32)

    blocks_total = Hb * Wb
    usable = valid_count > 0
    blocks_drop_water = 0

    if water_mask_2d is not None:
        water_trim = water_mask_2d[:Ht, :Wt]
        water_blk = water_trim.reshape(Hb, block, Wb, block).transpose(0,2,1,3)
        water_in_valid = (water_blk & valid_blk).sum(axis=(2,3)).astype(np.int32)
        water_frac = water_in_valid / np.maximum(valid_count, 1)
        drop_water = (water_frac > water_frac_thr) & usable
        blocks_drop_water = int(drop_water.sum())
        usable = usable & (~drop_water)
        land_blk = valid_blk & (~water_blk)
    else:
        land_blk = valid_blk

    block_indices = np.argwhere(usable)
    chosen = np.empty((block_indices.shape[0],), dtype=np.int64)
    keep_n = 0

    for bi, bj in block_indices:
        if water_mask_2d is not None and require_land_pixel:
            sub = land_blk[bi, bj]
            rr, cc = np.where(sub)
            if rr.size == 0:
                sub2 = valid_blk[bi, bj]
                rr, cc = np.where(sub2)
        else:
            sub2 = valid_blk[bi, bj]
            rr, cc = np.where(sub2)

        if rr.size == 0:
            continue
        k = rng.integers(0, rr.size)
        r = bi * block + rr[k]
        c = bj * block + cc[k]
        chosen[keep_n] = r * W + c
        keep_n += 1

    stats = {"blocks_total": int(blocks_total), "blocks_used": int(keep_n), "blocks_drop_water": int(blocks_drop_water)}
    return chosen[:keep_n], stats

def build_city_month_slab(city, yyyymm, spatial_subsample=2):
    """
    Build a (H2,W2,C) slab for a given city and YYYYMM by reading all GeoTIFF files and aggregating bands.
    Returns: slab, channels_all, target_ch, meta (H2,W2,transform info from first file)
    """
    cdir, files = list_city_files(city)
    assert files, f"No tif in {cdir}"

    example_shape = None
    index_per_file = []
    all_channels = set()

    # scan structure
    for fn in files:
        path = os.path.join(cdir, fn)
        major = infer_var_from_filename(fn, city)
        with rasterio.open(path) as ds:
            if example_shape is None:
                example_shape = (ds.height, ds.width)
                first_transform = ds.transform
            else:
                if (ds.height, ds.width) != example_shape:
                    continue
            descs = get_band_descs(ds)
            triples = []
            for b in range(1, ds.count+1):
                ch, mk = parse_band_desc(descs[b-1], major)
                if mk == yyyymm or mk == "STATIC":
                    all_channels.add(ch)
                    triples.append((b, mk, ch))
            if triples:
                index_per_file.append((path, triples))

    channels = sorted(all_channels)
    ch2i = {c:i for i,c in enumerate(channels)}

    H,W = example_shape
    H2,W2 = out_hw(H,W,spatial_subsample)
    C = len(channels)

    # prepare SUM/CNT for that month, plus static cache
    slab = np.full((H2,W2,C), np.nan, np.float32)
    SUM = np.zeros((H2,W2,C), np.float32)
    CNT = np.zeros((H2,W2,C), np.uint16)
    static_cache = {}

    def add_sumcnt(c_idx, arr2d):
        m = np.isfinite(arr2d)
        if m.any():
            SUM[:arr2d.shape[0], :arr2d.shape[1], c_idx][m] += arr2d[m]
            CNT[:arr2d.shape[0], :arr2d.shape[1], c_idx][m] += 1

    # read
    for path, triples in index_per_file:
        with rasterio.open(path) as ds:
            oh, ow = out_hw(ds.height, ds.width, spatial_subsample)
            # bucket by (mk,ch)
            per_bucket = {}
            for b, mk, ch in triples:
                per_bucket.setdefault((mk,ch), []).append(b)

            for (mk,ch), band_list in per_bucket.items():
                c_idx = ch2i[ch]
                resamp = Resampling.nearest if is_categorical_channel(ch) else Resampling.average
                band_list = sorted(band_list)
                data = ds.read(indexes=band_list, masked=True,
                               out_shape=(len(band_list), oh, ow),
                               resampling=resamp).astype(np.float32)
                if np.ma.isMaskedArray(data):
                    data = data.filled(np.nan)

                if is_categorical_channel(ch):
                    arr = np.rint(data[0]).astype(np.float32)
                else:
                    arr = np.nanmean(data, axis=0).astype(np.float32)

                if mk == "STATIC":
                    # cache static (fill missing only for categorical, average for continuous if multiple)
                    if c_idx not in static_cache:
                        static_cache[c_idx] = arr
                    else:
                        acc = static_cache[c_idx]
                        if is_categorical_channel(ch):
                            m1 = np.isfinite(acc); m2 = np.isfinite(arr)
                            acc[~m1 & m2] = arr[~m1 & m2]
                            static_cache[c_idx] = acc
                        else:
                            m1 = np.isfinite(acc); m2 = np.isfinite(arr); both = m1 & m2
                            acc[~m1 & m2] = arr[~m1 & m2]
                            acc[both] = (acc[both] + arr[both]) / 2.0
                            static_cache[c_idx] = acc
                else:
                    add_sumcnt(c_idx, arr)

    # finalize month slab
    valid = CNT > 0
    slab[valid] = (SUM[valid] / CNT[valid]).astype(np.float32)
    for c_idx, arr in static_cache.items():
        slab[:arr.shape[0], :arr.shape[1], c_idx] = arr

    target_ch = choose_target_channel(channels)
    meta = {"H2":H2, "W2":W2, "transform": first_transform, "spatial_subsample": spatial_subsample}
    return slab, channels, target_ch, meta


# =========================
# 3) Moran's I (kNN weights) + permutation p-value
# =========================
def morans_I_knn(z, xy, k=8, n_perm=199, seed=42):
    """
    z: (N,) residuals
    xy: (N,2) coordinates (in meters/deg, consistent)
    build kNN weights (row-standardized), compute Moran's I with permutation test.
    """
    rng = np.random.default_rng(seed)
    z = np.asarray(z, dtype=float)
    z = z - np.mean(z)
    N = z.size
    if N < (k+2):
        return np.nan, np.nan

    nn = NearestNeighbors(n_neighbors=k+1, algorithm="auto").fit(xy)
    dist, idx = nn.kneighbors(xy)  # first neighbor is itself
    neigh = idx[:, 1:]  # (N,k)

    # weights: w_ij = 1/k (row-standardized)
    w = 1.0 / k
    # numerator: sum_i sum_j w_ij z_i z_j
    num = 0.0
    for i in range(N):
        num += z[i] * np.sum(z[neigh[i]]) * w
    den = np.sum(z**2)
    W = N  # since row-standardized, sum weights per row=1 => total W = N

    I = (N / W) * (num / den)

    # permutation test (two-sided via |I|)
    I_perm = np.zeros((n_perm,), dtype=float)
    for p in range(n_perm):
        zp = rng.permutation(z)
        nump = 0.0
        for i in range(N):
            nump += zp[i] * np.sum(zp[neigh[i]]) * w
        I_perm[p] = (N / W) * (nump / den)

    p_two = (np.sum(np.abs(I_perm) >= np.abs(I)) + 1) / (n_perm + 1)
    return float(I), float(p_two)


