RANDOM_SEED = 42
K = 5

N_PER_FOLD = 200000
R = 5
SIGMA_LIST = [0.00, 0.05, 0.10, 0.20]

PERTURB_FEATURES = ["EVI.EVI", "LAI.LAI"]

DROP_FEATURES = {
    "ERA5LMAIN.STL1",
    "ERA5LMAIN.T2M",
    "ERA5LMAIN.TD",
    "META.CITY_ID",
}

CB_PARAMS_GPU = dict(
    iterations=3000,
    depth=8,
    learning_rate=0.05,
    l2_leaf_reg=3.0,
    loss_function="RMSE",
    eval_metric="RMSE",
    random_seed=RANDOM_SEED,
    task_type="GPU",
    devices="0",
    od_type="Iter",
    od_wait=150,
    verbose=False,
)

CB_PARAMS_CPU = dict(
    iterations=2000,
    depth=8,
    learning_rate=0.05,
    l2_leaf_reg=3.0,
    loss_function="RMSE",
    eval_metric="RMSE",
    random_seed=RANDOM_SEED,
    od_type="Iter",
    od_wait=150,
    verbose=False,
)

# ---------------------------
# 1) Load NPZ
# ---------------------------
npz = np.load(NPZ_PATH, allow_pickle=True)

X = npz["X"].astype(np.float32)
y = npz["y"].astype(np.float32)
channels = npz["channels"].astype(object).tolist()

if "sample_city_id" not in npz.files:
    raise RuntimeError("NPZ missing sample_city_id metadata.")

city_id = npz["sample_city_id"].astype(np.int32)

print(f"Loaded: X={X.shape}, y={y.shape}, n_channels={len(channels)}")
print("Channels:", channels)

m = np.isfinite(y)
X = X[m]
y = y[m]
city_id = city_id[m]

print(f"After y finite mask: X={X.shape}, y={y.shape}")
print("City groups:", len(np.unique(city_id)))

# ---------------------------
# 2) Feature filtering
# ---------------------------
keep_idx = []
dropped = []

for i, ch in enumerate(channels):
    ch_upper = str(ch).upper()

    if ch in DROP_FEATURES:
        dropped.append(ch)
    elif ch_upper.startswith("LST.") or "LST" in ch_upper:
        dropped.append(ch)
    else:
        keep_idx.append(i)

X = X[:, keep_idx]
channels_final = [channels[i] for i in keep_idx]

print(f"Kept features={len(channels_final)}")
print("Final features:", channels_final)
print("Dropped:", dropped)

assert "META.CITY_ID" not in channels_final
assert "ERA5LMAIN.T2M" not in channels_final
assert "ERA5LMAIN.TD" not in channels_final
assert "ERA5LMAIN.STL1" not in channels_final

perturb_cols = []
missing = []

for f in PERTURB_FEATURES:
    if f in channels_final:
        perturb_cols.append(channels_final.index(f))
    else:
        missing.append(f)

if missing:
    raise RuntimeError(f"Missing perturb features: {missing}")

feat_std = np.nanstd(X, axis=0).astype(np.float32)
feat_std[~np.isfinite(feat_std)] = 0.0
feat_std[feat_std == 0] = 1.0

# ---------------------------
# 3) Helpers
# ---------------------------
def evaluate(y_true, y_pred):
    rmse = float(mean_squared_error(y_true, y_pred) ** 0.5)
    mae = float(mean_absolute_error(y_true, y_pred))
    r2 = float(r2_score(y_true, y_pred))
    return rmse, mae, r2

def train_catboost(Xtr, ytr, Xva, yva, feature_names):
    train_pool = Pool(Xtr, ytr, feature_names=feature_names)
    val_pool = Pool(Xva, yva, feature_names=feature_names)

    try:
        model = CatBoostRegressor(**CB_PARAMS_GPU)
        model.fit(train_pool, eval_set=val_pool, use_best_model=True)
        return model, True
    except Exception as e:
        print("[GPU fallback]", repr(e))
        model = CatBoostRegressor(**CB_PARAMS_CPU)
        model.fit(train_pool, eval_set=val_pool, use_best_model=True)
        return model, False

def sample_indices(rng, n, k):
    if k <= 0 or k >= n:
        return np.arange(n, dtype=np.int64)
    return rng.choice(n, size=k, replace=False)

def perturb_X_gaussian(Xbase, cols, sigma_rel, rng):
    if sigma_rel <= 0:
        return Xbase

    Xp = Xbase.copy()

    for c in cols:
        s = sigma_rel * feat_std[c]
        noise = rng.normal(0.0, s, size=Xp.shape[0]).astype(np.float32)
        Xp[:, c] = Xp[:, c] + noise

    return Xp.astype(np.float32)

def mean_ci95(arr):
    arr = np.asarray(arr, dtype=float)
    m = float(np.mean(arr))

    if arr.size <= 1:
        return m, 0.0

    se = float(np.std(arr, ddof=1) / np.sqrt(arr.size))
    return m, 1.96 * se

# ---------------------------
# 4) City-GroupKFold perturbation experiment
# ---------------------------
gkf = GroupKFold(n_splits=K)
rng = np.random.default_rng(RANDOM_SEED)

rows = []

stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
run_tag = f"perturb_citycv_{stamp}"
t0 = time.time()

for fold, (tr_idx, te_idx) in enumerate(gkf.split(X, y, groups=city_id), 1):
    Xtr_full, ytr_full = X[tr_idx], y[tr_idx]
    Xte_full, yte_full = X[te_idx], y[te_idx]

    ntr = Xtr_full.shape[0]
    val_n = min(200000, max(50000, int(0.1 * ntr)))

    val_idx_local = sample_indices(rng, ntr, val_n)
    tr_mask = np.ones(ntr, dtype=bool)
    tr_mask[val_idx_local] = False

    Xtr, ytr = Xtr_full[tr_mask], ytr_full[tr_mask]
    Xva, yva = Xtr_full[val_idx_local], ytr_full[val_idx_local]

    model, used_gpu = train_catboost(Xtr, ytr, Xva, yva, channels_final)

    nte = Xte_full.shape[0]
    take = min(N_PER_FOLD, nte)
    take_idx = sample_indices(rng, nte, take)

    Xte = Xte_full[take_idx]
    yte = yte_full[take_idx]

    yhat0 = model.predict(Xte)
    rmse0, mae0, r20 = evaluate(yte, yhat0)

    print(
        f"[Fold {fold}/{K}] baseline RMSE={rmse0:.3f}, "
        f"MAE={mae0:.3f}, R2={r20:.3f}, GPU={used_gpu}, test_n={take}"
    )

    for sigma in SIGMA_LIST:
        deltas = []
        rmses = []

        for rep in range(R):
            rrng = np.random.default_rng(
                RANDOM_SEED + fold * 1000 + rep * 10 + int(sigma * 100)
            )

            Xp = perturb_X_gaussian(Xte, perturb_cols, sigma, rrng)
            yhat = model.predict(Xp)
            rmse, _, _ = evaluate(yte, yhat)

            rmses.append(rmse)
            deltas.append(rmse - rmse0)

        d_mean, d_ci = mean_ci95(deltas)
        r_mean, r_ci = mean_ci95(rmses)

        rows.append({
            "fold": fold,
            "sigma_rel": float(sigma),
            "test_n": int(take),
            "baseline_rmse": rmse0,
            "baseline_mae": mae0,
            "baseline_r2": r20,
            "pert_rmse_mean": r_mean,
            "pert_rmse_ci95": r_ci,
            "delta_rmse_mean": d_mean,
            "delta_rmse_ci95": d_ci,
            "perturb_features": ",".join(PERTURB_FEATURES),
            "used_gpu": bool(used_gpu),
        })

df = pd.DataFrame(rows)

csv_path = os.path.join(OUT_DIR, f"{run_tag}.csv")
json_path = os.path.join(OUT_DIR, f"{run_tag}.json")
fig_path = os.path.join(OUT_DIR, f"{run_tag}.png")

df.to_csv(csv_path, index=False)

with open(json_path, "w") as f:
    json.dump(
        {
            "npz": NPZ_PATH,
            "K": K,
            "N_PER_FOLD": N_PER_FOLD,
            "R": R,
            "SIGMA_LIST": SIGMA_LIST,
            "PERTURB_FEATURES": PERTURB_FEATURES,
            "DROP_FEATURES": sorted(list(DROP_FEATURES)),
            "features": channels_final,
            "n_samples": int(X.shape[0]),
            "n_features": int(X.shape[1]),
            "n_cities": int(len(np.unique(city_id))),
            "results": df.to_dict(orient="records"),
            "elapsed_sec": float(time.time() - t0),
        },
        f,
        indent=2,
    )

print("\nSaved:")
print(csv_path)
print(json_path)

# ---------------------------
# 5) Plot
# ---------------------------
g = df.groupby("sigma_rel")["delta_rmse_mean"].agg(["mean", "std"]).reset_index()
g["ci95"] = 1.96 * g["std"] / np.sqrt(K)

plt.figure(figsize=(7, 4.5))
plt.errorbar(g["sigma_rel"], g["mean"], yerr=g["ci95"], fmt="-o")
plt.axhline(0, linestyle=":", linewidth=1)
plt.xlabel("Noise level (sigma as fraction of feature std)")
plt.ylabel("ΔRMSE on holdout cities")
plt.title(f"Perturbation robustness, City-GroupKFold K={K}\nFeatures: {', '.join(PERTURB_FEATURES)}")
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig(fig_path, dpi=300, bbox_inches="tight")
plt.show()

print("Saved figure:", fig_path)
print("Elapsed sec:", round(time.time() - t0, 1))

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import spearmanr, pearsonr

NPZ_PATH = "/content/drive/MyDrive/anature_revised/multiyear_catboost_npz_with_metadata_fast_WITH_SWVL1_WIND10M_STL1/ALLCITIES_train_xy_MULTIYEAR_2013_2025_fine0.005_S1_maxCM3000_TOP100_WITH_ROWCOL_LOCALFAST_WITH_SWVL1_WIND10M_STL1.npz"

data = np.load(NPZ_PATH, allow_pickle=True)

X = data["X"]
channels = data["channels"].tolist()

df = pd.DataFrame(X, columns=channels)

EVI = df["EVI.EVI"].values
LAI = df["LAI.LAI"].values

mask = np.isfinite(EVI) & np.isfinite(LAI)

EVI = EVI[mask]
LAI = LAI[mask]

# 为了画图速度，只抽样
N = 100000
idx = np.random.choice(len(EVI), N, replace=False)

EVI = EVI[idx]
LAI = LAI[idx]

# 计算相关系数
r, _ = pearsonr(EVI, LAI)
rho, _ = spearmanr(EVI, LAI)

plt.figure(figsize=(6,5))

plt.hexbin(EVI, LAI, gridsize=80, cmap="viridis", mincnt=1)

plt.xlabel("EVI")
plt.ylabel("LAI")

plt.title("Correlation between EVI and LAI")

plt.text(
    0.02, 0.95,
    f"Pearson r = {r:.2f}\nSpearman ρ = {rho:.2f}",
    transform=plt.gca().transAxes,
    verticalalignment="top",
    bbox=dict(facecolor="white", alpha=0.8)
)

plt.colorbar(label="Counts")

plt.tight_layout()
plt.savefig("EVI_LAI_correlation.png", dpi=300)
plt.show()
