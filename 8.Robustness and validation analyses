# 4) Run diagnostics
# =========================
def xy_from_rc(rows, cols, meta):
    # use pixel indices as coordinates (consistent for Moran with kNN); scale by effective resolution
    # You can also convert to lon/lat with transform, but index-space is fine for spatial autocorr.
    s = meta["spatial_subsample"]
    return np.stack([cols * s, rows * s], axis=1).astype(np.float32)

records = []
rng = np.random.default_rng(42)

for city in CITIES_TO_TEST:
    for mm in MONTHS_TO_TEST:
        try:
            slab, ch_all, target_ch, meta = build_city_month_slab(city, mm, SPATIAL_SUBSAMPLE)
        except Exception as e:
            print(f"[SKIP] {city} {mm}: {repr(e)}")
            continue

        if target_ch is None:
            print(f"[SKIP] {city} {mm}: no target LST channel detected")
            continue

        ch2i = {c:i for i,c in enumerate(ch_all)}
        y_idx = ch2i[target_ch]

        # Build feature matrix aligned to model_channels
        # For any missing feature (shouldn't happen often), skip this city-month
        miss = [f for f in model_channels if f not in ch2i]
        if miss:
            print(f"[SKIP] {city} {mm}: missing features {miss[:5]}...")
            continue

        feat_idx = [ch2i[f] for f in model_channels]

        y = slab[..., y_idx].reshape(-1)
        X = slab[..., feat_idx].reshape(-1, len(feat_idx))

        # Urban core mask (NTL brightest 90%) for fair comparison
        ntl_ch = find_ntl_channel(ch_all)
        if ntl_ch is not None:
            ntl = slab[..., ch2i[ntl_ch]]
            core = build_ntl_core_mask(ntl, pct_brightest=90, ntl_min_abs=0.0).reshape(-1)
        else:
            core = np.isfinite(y)

        valid = core & np.isfinite(y) & np.all(np.isfinite(X), axis=1)
        if valid.sum() < 500:
            print(f"[SKIP] {city} {mm}: too few valid pixels ({valid.sum()})")
            continue

        # Prediction residuals on dense pixels
        Xv = X[valid]
        yv = y[valid]
        pred = model.predict(Xv)
        resid = (yv - pred).astype(np.float32)

        # dense: subsample for speed
        vidx = np.flatnonzero(valid)
        if resid.size > MAX_N_DENSE:
            pick = rng.choice(resid.size, size=MAX_N_DENSE, replace=False)
            resid_dense = resid[pick]
            vidx_dense = vidx[pick]
        else:
            resid_dense = resid
            vidx_dense = vidx

        rows_dense = (vidx_dense // meta["W2"]).astype(np.int32)
        cols_dense = (vidx_dense %  meta["W2"]).astype(np.int32)
        xy_dense = xy_from_rc(rows_dense, cols_dense, meta)

        I_dense, p_dense = morans_I_knn(resid_dense, xy_dense, k=KNN_K, n_perm=N_PERM, seed=42)

        records.append({
            "city": city, "month": mm, "scheme": "dense",
            "N": int(resid_dense.size), "MoranI": I_dense, "p_perm": p_dense
        })

        # ERA5-guided: one pixel per ERA5 block, drop water-dominated blocks
        # water mask from LC if exists
        water_mask2d = infer_water_mask_from_lc(ch_all, ch2i, slab)
        core2d = core.reshape(meta["H2"], meta["W2"])
        valid2d = valid.reshape(meta["H2"], meta["W2"])

        block = era5_block_size(FINE_DEG, ERA_DEG, SPATIAL_SUBSAMPLE)
        pix_idx, stats_blk = era5_guided_one_pixel_per_block_waterdrop(
            valid_mask_2d=valid2d & core2d,
            block=block,
            rng=rng,
            water_mask_2d=water_mask2d,
            water_frac_thr=WATER_FRAC_THR,
            require_land_pixel=REQUIRE_LAND_PIXEL
        )

        if pix_idx.size < 80:
            print(f"[WARN] {city} {mm}: too few ERA5-guided samples ({pix_idx.size})")
            continue

        Xb = X[pix_idx]
        yb = y[pix_idx]
        pred_b = model.predict(Xb)
        resid_b = (yb - pred_b).astype(np.float32)

        rows_b = (pix_idx // meta["W2"]).astype(np.int32)
        cols_b = (pix_idx %  meta["W2"]).astype(np.int32)
        xy_b = xy_from_rc(rows_b, cols_b, meta)

        I_b, p_b = morans_I_knn(resid_b, xy_b, k=min(KNN_K, max(3, pix_idx.size-2)), n_perm=N_PERM, seed=42)

        records.append({
            "city": city, "month": mm, "scheme": "era5_1ppc",
            "N": int(resid_b.size), "MoranI": I_b, "p_perm": p_b,
            "block": block, "blocks_total": stats_blk["blocks_total"],
            "blocks_used": stats_blk["blocks_used"], "blocks_drop_water": stats_blk["blocks_drop_water"]
        })

        print(f"[OK] {city} {mm}  dense(I={I_dense:.3f},p={p_dense:.3f},N={resid_dense.size})"
              f"  vs  era5(I={I_b:.3f},p={p_b:.3f},N={resid_b.size},dropW={stats_blk['blocks_drop_water']})")

df = pd.DataFrame(records)
df.to_csv(OUT_CSV, index=False, encoding="utf-8")
print("Saved:", OUT_CSV)

